<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head') -%>
<%- include('../partials/header') -%>
<body>
  <main class="container my-4">
    <a href="/toolcatalog/">← Tool Catalog</a>
    <h1 class="mt-3"><%= tool.platform_name %></h1>
    <table class="table table-striped mt-3">
      <tbody>
        <tr><th scope="row">Platform</th><td><%= tool.platform_name %></td></tr>
        <% if (tool.catalog_type) { %><tr><th scope="row">Catalog Type</th><td><%= tool.catalog_type %></td></tr><% } %>
        <% if (tool.description) { %><tr><th scope="row">Description</th><td><%= tool.description %></td></tr><% } %>
        <% if (tool.license) { %><tr><th scope="row">License</th><td><%= tool.license %></td></tr><% } %>
        <% if (tool.interface) { %><tr><th scope="row">Standards Support</th><td><%= tool.interface %></td></tr><% } %>
        <% if (tool.contact_email) { %><tr><th scope="row">Contact</th><td><a href="mailto:<%= tool.contact_email %>"><%= tool.contact_email %></a></td></tr><% } %>
        <tr><th scope="row">Resource</th><td><a href="<%= tool.url %>" target="_blank" rel="noopener" data-usage-external-click data-catalog-type="TOOL" data-item-identifier="<%= tool.id %>" data-link-type="tool_url">Open Tool</a></td></tr>
      </tbody>
    </table>
  </main>
<script src="/js/usageTracking.js"></script>
</body>
<%- include('../partials/footer') -%>
</html>
