<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> · SPLICE</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous">
  <link rel="stylesheet" href="/css/usage-statistics.css">
  <script src="/js/usageDashboard.js" defer></script>
</head>
<body class="usage-dashboard-body">
  <%- include('../partials/header') -%>
  <main class="usage-page" data-usage-dashboard>
    <header class="usage-heading">
      <nav class="usage-breadcrumb" aria-label="Breadcrumb"><a href="/admin">Admin panel</a><span aria-hidden="true">/</span><span aria-current="page">Usage Statistics</span></nav>
      <h1>Usage Statistics</h1>
      <p>Track intentional catalog selections, resource clicks, and submitted searches.</p>
    </header>

    <section class="usage-filters" aria-label="Usage statistics filters">
      <form action="/admin/usage-statistics" method="GET" class="usage-filter-form" data-filter-form data-today="<%= today %>">
        <label>Time period<select name="period" id="usagePeriod">
          <% [['all', 'All time'], ['7d', 'Last 7 days'], ['30d', 'Last 30 days'], ['custom', 'Custom range']].forEach(([value, label]) => { %>
            <option value="<%= value %>" <%= period === value ? 'selected' : '' %>><%= label %></option>
          <% }); %>
        </select></label>
        <label>From<input type="date" name="from" id="usageFrom" value="<%= from %>"></label>
        <label>To<input type="date" name="to" id="usageTo" value="<%= to %>"></label>
        <label>Catalog type<select name="catalogType" id="usageCatalogType">
          <% [['ALL', 'All catalogs'], ['SLC_ITEM', 'SLC Items'], ['TOOL', 'Tools'], ['DATASET', 'Datasets']].forEach(([value, label]) => { %>
            <option value="<%= value %>" <%= selectedCatalogType === value ? 'selected' : '' %>><%= label %></option>
          <% }); %>
        </select></label>
        <input type="hidden" name="tab" value="<%= activeTab %>" data-active-tab-input>
        <div class="usage-filter-actions"><button class="usage-primary-button" type="submit">Apply filters</button><a href="/admin/usage-statistics" class="usage-reset">Reset</a></div>
      </form>
      <% if (validationMessage) { %><p class="usage-validation" role="alert"><%= validationMessage %></p><% } %>
    </section>
    <div class="usage-context"><span><i aria-hidden="true"></i><%= rangeLabel || 'Choose a valid time period' %></span><span><%= catalogContextLabel %></span></div>

    <section class="usage-kpis" aria-label="Usage totals">
      <% const kpis = [
        ['Entry Clicks', overallStatistics.totalEntryClicks, 'Intentional selections of catalog entry links'],
        ['External Resource Clicks', overallStatistics.totalExternalClicks, 'Intentional outgoing resource selections'],
        ['Unique Catalog Entries', uniqueCatalogEntries, 'Entries with entry or external clicks'],
        ['Web Searches', overallStatistics.webSearches, 'Explicit nonempty form submissions'],
        ['Public API Searches', overallStatistics.publicApiSearches, 'Completed nonempty public API searches'],
      ]; %>
      <% kpis.forEach(([label, count, description]) => { %>
        <article class="usage-kpi"><h2><%= label %></h2><p class="usage-kpi-value"><%= count.toLocaleString() %></p><p class="usage-kpi-description"><%= description %></p></article>
      <% }); %>
    </section>

    <%
      const activityRows = activityOverTime || [];
      const hasActivity = activityRows.some((row) => row.entryClicks > 0 || row.externalClicks > 0 || row.publicApiSearches > 0);
      const chartWidth = 850, chartHeight = 235, left = 44, right = 22, top = 15, bottom = 38;
      const plotWidth = chartWidth - left - right, plotHeight = chartHeight - top - bottom;
      const maxValue = Math.max(1, ...activityRows.map((row) => Math.max(row.entryClicks, row.externalClicks, row.publicApiSearches)));
      const axisMax = Math.max(4, Math.ceil(maxValue / 4) * 4);
      const dayStamp = (row) => Date.parse(row.date + 'T00:00:00Z');
      const firstDay = activityRows.length ? dayStamp(activityRows[0]) : 0;
      const lastDay = activityRows.length ? dayStamp(activityRows[activityRows.length - 1]) : firstDay;
      const xFor = (row) => lastDay === firstDay ? left + plotWidth / 2 : left + (dayStamp(row) - firstDay) * plotWidth / (lastDay - firstDay);
      const yFor = (count) => top + plotHeight - count / axisMax * plotHeight;
      // Markers are real daily totals; straight lines connect reporting dates without inventing events.
      const pathFor = (key) => activityRows.map((row, index) => `${index ? 'L' : 'M'}${xFor(row)},${yFor(row[key])}`).join(' ');
      const dateLabelIndexes = [...new Set(Array.from({ length: Math.min(5, activityRows.length) }, (_, index) => Math.round(index * (activityRows.length - 1) / Math.max(1, Math.min(5, activityRows.length) - 1))))];
      const formatChartDate = (date) => new Date(date + 'T00:00:00Z').toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
      const catalogTypes = ['SLC_ITEM', 'TOOL', 'DATASET'];
      const catalogLabels = { SLC_ITEM: 'SLC Items', TOOL: 'Tools', DATASET: 'Datasets' };
      const catalogClasses = { SLC_ITEM: 'slc-item', TOOL: 'tool', DATASET: 'dataset' };
      const catalogRows = catalogTypes.map((type) => ({ catalogType: type, label: catalogLabels[type], count: (catalogTypeActivity || []).find((row) => row.catalogType === type)?.count || 0 }));
      const catalogTotal = catalogRows.reduce((sum, row) => sum + row.count, 0);
      const circumference = 2 * Math.PI * 47;
      let donutOffset = 0;
    %>
    <section class="usage-charts" aria-label="Click activity charts">
      <article class="usage-panel">
        <div class="usage-panel-heading"><div><h2>Activity Over Time</h2><p>Intentional clicks and public API searches by day</p></div>
          <div class="usage-chart-legend"><span><i class="usage-blue" aria-hidden="true"></i>Entry Clicks</span><span><i class="usage-orange" aria-hidden="true"></i>External Clicks</span><span><i class="usage-green" aria-hidden="true"></i>Public API Searches</span></div>
        </div>
        <% if (!hasActivity) { %><div class="usage-chart-empty">No clicks or public API searches recorded for this period.</div><% } else { %>
          <div class="usage-line-chart-wrap"><svg class="usage-line-chart" viewBox="0 0 <%= chartWidth %> <%= chartHeight %>" role="img" aria-labelledby="usageLineTitle usageLineDescription">
            <title id="usageLineTitle">Daily entry clicks, external clicks, and public API searches</title><desc id="usageLineDescription">Real daily totals by calendar date. Blue shows entry clicks, orange shows external clicks, and green shows public API searches. Markers show exact daily counts; straight lines connect reporting dates.</desc>
            <% for (let index = 0; index <= 4; index++) { const value = axisMax * index / 4; %>
              <line class="usage-gridline" x1="<%= left %>" y1="<%= yFor(value) %>" x2="<%= chartWidth - right %>" y2="<%= yFor(value) %>"></line>
              <text class="usage-axis-label" x="<%= left - 10 %>" y="<%= yFor(value) + 4 %>" text-anchor="end"><%= value.toLocaleString() %></text>
            <% } %>
            <path class="usage-series usage-series--entry" d="<%= pathFor('entryClicks') %>"></path><path class="usage-series usage-series--external" d="<%= pathFor('externalClicks') %>"></path><path class="usage-series usage-series--api" d="<%= pathFor('publicApiSearches') %>"></path>
            <% activityRows.forEach((row) => { %>
              <circle class="usage-point usage-point--entry" data-day="<%= dayStamp(row) %>" cx="<%= xFor(row) %>" cy="<%= yFor(row.entryClicks) %>" r="4"><title><%= row.date %>: <%= row.entryClicks %> entry clicks</title></circle>
              <circle class="usage-point usage-point--external" data-day="<%= dayStamp(row) %>" cx="<%= xFor(row) %>" cy="<%= yFor(row.externalClicks) %>" r="4"><title><%= row.date %>: <%= row.externalClicks %> external clicks</title></circle>
              <circle class="usage-point usage-point--api" data-day="<%= dayStamp(row) %>" cx="<%= xFor(row) %>" cy="<%= yFor(row.publicApiSearches) %>" r="4"><title><%= row.date %>: <%= row.publicApiSearches %> public API searches</title></circle>
            <% }); %>
            <% dateLabelIndexes.forEach((index) => { const row = activityRows[index]; %><text class="usage-axis-label" data-day="<%= dayStamp(row) %>" x="<%= xFor(row) %>" y="<%= chartHeight - 13 %>" text-anchor="middle"><%= formatChartDate(row.date) %></text><% }); %>
          </svg></div>
        <% } %>
      </article>
      <article class="usage-panel">
        <div class="usage-panel-heading"><div><h2>Entry Clicks by Catalog Type</h2><p>Distribution across catalogs</p></div></div>
        <div class="usage-donut-layout">
          <svg class="usage-donut" viewBox="0 0 120 120" role="img" aria-label="<%= catalogTotal.toLocaleString() %> total entry clicks across catalogs">
            <circle class="usage-donut-track" cx="60" cy="60" r="47"></circle>
            <% catalogRows.forEach((row) => { if (row.count > 0 && catalogTotal > 0) { const length = row.count / catalogTotal * circumference; %>
              <circle class="usage-donut-segment usage-donut-segment--<%= catalogClasses[row.catalogType] %>" cx="60" cy="60" r="47" transform="rotate(-90 60 60)" stroke-dasharray="<%= length %> <%= circumference - length %>" stroke-dashoffset="-<%= donutOffset %>"><title><%= row.label %>: <%= row.count.toLocaleString() %> entry clicks</title></circle>
              <% donutOffset += length; } }); %>
            <text class="usage-donut-total" x="60" y="58" text-anchor="middle"><%= catalogTotal.toLocaleString() %></text><text class="usage-donut-caption" x="60" y="72" text-anchor="middle">Entry Clicks</text>
          </svg>
          <ul class="usage-donut-legend">
            <% catalogRows.forEach((row) => { %><li><i class="usage-dot usage-dot--<%= catalogClasses[row.catalogType] %>" aria-hidden="true"></i><span><%= row.label %></span><strong><%= row.count.toLocaleString() %></strong><small><%= catalogTotal ? (row.count / catalogTotal * 100).toFixed(1).replace(/\.0$/, '') : '0' %>%</small></li><% }); %>
          </ul>
        </div>
        <% if (!catalogTotal) { %><p class="usage-donut-empty">No entry clicks recorded for these filters.</p><% } %>
      </article>
    </section>

    <section class="usage-statistics-panel usage-panel" aria-label="Detailed usage statistics" data-initial-tab="<%= activeTab %>">
      <div class="usage-tabs" role="tablist" aria-label="Statistics tables">
        <button type="button" role="tab" id="usage-tab-entries" aria-controls="usage-panel-entries" aria-selected="<%= activeTab === 'entries' %>" tabindex="<%= activeTab === 'entries' ? 0 : -1 %>" data-tab="entries">Catalog Entry Statistics <span data-tab-count="entries"><%= itemStatistics.length.toLocaleString() %></span></button>
        <button type="button" role="tab" id="usage-tab-terms" aria-controls="usage-panel-terms" aria-selected="<%= activeTab === 'terms' %>" tabindex="<%= activeTab === 'terms' ? 0 : -1 %>" data-tab="terms">Frequent Search Terms <span data-tab-count="terms"><%= searchTerms.length.toLocaleString() %></span></button>
        <button type="button" role="tab" id="usage-tab-historical" aria-controls="usage-panel-historical" aria-selected="<%= activeTab === 'historical' %>" tabindex="<%= activeTab === 'historical' ? 0 : -1 %>" data-tab="historical">Historical Nginx Data <span data-tab-count="historical">—</span></button>
      </div>
      <% const exportBase = '/admin/usage-statistics/export' + (exportQuery ? '?' + exportQuery : ''); const csvBase = '/admin/usage-statistics/export.csv' + (exportQuery ? '?' + exportQuery : ''); %>
      <div role="tabpanel" id="usage-panel-entries" aria-labelledby="usage-tab-entries" tabindex="0" data-statistics-table="entries" <%= activeTab !== 'entries' ? 'hidden' : '' %>>
        <div class="usage-table-toolbar"><label class="usage-search"><span class="usage-sr-only">Search catalog entries</span><input type="search" id="catalogEntrySearch" placeholder="Search by title or URL…" value="<%= searchQuery %>" autocomplete="off" data-table-search></label>
          <div class="usage-export-actions"><a href="<%= exportBase %>" data-export-link title="Download the entire dashboard as JSON with the applied date and catalog filters">Download JSON</a><a href="<%= csvBase %>" data-export-link title="Download the entire dashboard as CSV with the applied date and catalog filters">Download CSV</a></div>
        </div>
        <div class="usage-table-scroll"><table class="usage-table"><caption class="usage-sr-only">Live entry clicks and external resource clicks by catalog entry</caption><thead><tr><th scope="col">Type</th><th scope="col">Catalog Entry</th><th scope="col" class="usage-number">Entry Clicks</th><th scope="col" class="usage-number">External Clicks</th></tr></thead>
          <tbody>
            <% itemStatistics.forEach((item) => { %><tr data-table-row data-search-text="<%= [item.itemTitle, item.catalogPath || '', item.itemPersistentID].join(' ') %>">
              <td><span class="catalog-type-badge catalog-type-badge--<%= catalogClasses[item.catalogType] || 'unknown' %>"><%= item.catalogType === 'SLC_ITEM' ? 'SLC Item' : item.catalogType === 'TOOL' ? 'Tool' : item.catalogType === 'DATASET' ? 'Dataset' : 'Unknown' %></span></td>
              <td><% if (item.catalogPath) { %><a class="usage-item-link" href="<%= item.catalogPath %>"><%= item.itemTitle %></a><% } else { %><span><%= item.itemTitle %></span><% } %></td><td class="usage-number"><%= item.entryClicks.toLocaleString() %></td><td class="usage-number"><%= item.externalClicks.toLocaleString() %></td>
            </tr><% }); %>
            <tr data-table-empty <%= itemStatistics.length ? 'hidden' : '' %>><td colspan="4" class="usage-empty">No live click activity recorded for these filters.</td></tr>
          </tbody></table></div>
        <div class="usage-table-footer"><p data-table-summary aria-live="polite"><%= itemStatistics.length.toLocaleString() %> catalog entries</p><nav class="usage-pagination" aria-label="Catalog entry pages" data-table-pagination></nav></div>
      </div>
      <div role="tabpanel" id="usage-panel-terms" aria-labelledby="usage-tab-terms" tabindex="0" data-statistics-table="terms" <%= activeTab !== 'terms' ? 'hidden' : '' %>>
        <div class="usage-table-toolbar"><label class="usage-search"><span class="usage-sr-only">Search terms</span><input type="search" id="searchTermSearch" placeholder="Search terms…" autocomplete="off" data-table-search></label><div class="usage-export-actions"><a href="<%= exportBase %>" data-export-link title="Download the entire dashboard as JSON with the applied date and catalog filters">Download JSON</a><a href="<%= csvBase %>" data-export-link title="Download the entire dashboard as CSV with the applied date and catalog filters">Download CSV</a></div></div>
        <p class="usage-terms-note">Top normalized terms. Web counts explicit submissions; public API counts completed requests. Keyword links and background retrieval are excluded.</p>
        <div class="usage-table-scroll"><table class="usage-table"><caption class="usage-sr-only">Top 100 normalized search terms for the selected filters</caption><thead><tr><th scope="col">Search term</th><th scope="col" class="usage-number">Web Searches</th><th scope="col" class="usage-number">Public API Searches</th><th scope="col" class="usage-number">Total</th></tr></thead><tbody>
          <% searchTerms.forEach((term) => { %><tr data-table-row data-search-text="<%= term.query %>"><td><%= term.query %></td><td class="usage-number"><%= term.webSearches.toLocaleString() %></td><td class="usage-number"><%= term.publicApiSearches.toLocaleString() %></td><td class="usage-number"><%= term.totalSearches.toLocaleString() %></td></tr><% }); %>
          <tr data-table-empty <%= searchTerms.length ? 'hidden' : '' %>><td colspan="4" class="usage-empty">No submitted search terms recorded for these filters.</td></tr>
        </tbody></table></div>
        <div class="usage-table-footer"><p data-table-summary aria-live="polite"><%= searchTerms.length.toLocaleString() %> search terms</p><nav class="usage-pagination" aria-label="Search term pages" data-table-pagination></nav></div>
      </div>
      <div role="tabpanel" id="usage-panel-historical" aria-labelledby="usage-tab-historical" tabindex="0" data-statistics-table="historical" <%= activeTab !== 'historical' ? 'hidden' : '' %>>
        <div class="usage-table-toolbar"><label class="usage-search"><span class="usage-sr-only">Search historical entries</span><input type="search" id="historicalEntrySearch" placeholder="Search by title or catalog type…" maxlength="200" autocomplete="off" data-table-search></label>
          <div class="usage-export-actions"><a href="/admin/usage-statistics/historical/export" title="Download all historical entries as JSON">Download JSON</a><a href="/admin/usage-statistics/historical/export.csv" title="Download all historical entries as CSV">Download CSV</a></div>
        </div>
        <p class="usage-terms-note" data-historical-totals aria-live="polite">Historical totals load when this tab is opened.</p>
        <p class="usage-terms-note">All-time SLC page-request aggregates, not confirmed human clicks. Date and catalog filters above apply only to live statistics.</p>
        <div class="usage-table-scroll"><table class="usage-table"><caption class="usage-sr-only">All-time historical Nginx page requests by catalog entry</caption><thead><tr><th scope="col">Type</th><th scope="col">Catalog Entry</th><th scope="col" class="usage-number">Historical Page Requests</th></tr></thead><tbody data-historical-rows>
          <tr data-table-empty><td colspan="3" class="usage-empty">Open this tab to load historical entries.</td></tr>
        </tbody></table></div>
        <div class="usage-table-footer"><p data-table-summary aria-live="polite"></p><nav class="usage-pagination" aria-label="Historical entry pages" data-table-pagination></nav></div>
      </div>
    </section>

  </main>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
